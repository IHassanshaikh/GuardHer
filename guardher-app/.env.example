# ==============================================================================
# GUARDHER — WOMEN'S SAFETY AI (PAKISTAN)
# Environment Variables & API Key Requirements Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or set these in your
# hosting provider (Vercel, Railway, AWS Amplify, Docker):
#
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# Used in emergency SMS notifications to generate the direct web tracking link
# sent to trusted family contacts (e.g., https://guardher.pk/contact-view).
# Default for local development: http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. TWILIO SMS GATEWAY (EMERGENCY DISPATCH TO TRUSTED CONTACTS)
# ------------------------------------------------------------------------------
# Required for sending real-time SMS alerts to guardians during ride start and
# when "I Feel Unsafe" or "SOS" emergency triggers are activated.
#
# How to obtain:
# 1. Sign up at https://www.twilio.com (Free trial gives free test credits).
# 2. Go to Console Dashboard -> Account Info -> Copy "Account SID" and "Auth Token".
# 3. Buy or configure a phone number enabled for SMS -> Copy "Twilio Phone Number".
#
# Fallback behavior: If left unset, GuardHer automatically runs in Safe Simulation Mode,
# logging full SMS dispatch payloads directly to backend logs and console without errors.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 3. MAPPING & GEO-INTELLIGENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# GuardHer includes a built-in vector canvas map with Pakistani landmark radar
# checkpoints (Liberty Lahore, Clifton Karachi, F-6 Islamabad) with zero external
# dependencies. If you wish to enable Google Maps Satellite or Street View:
#
# Google Maps API Key:
# Obtain from https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Mapbox GL Access Token (Alternative map provider):
# Obtain from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ------------------------------------------------------------------------------
# 4. POLICE & EMERGENCY INTEGRATION WEBHOOKS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Direct computer-aided dispatch (CAD) webhook for Punjab Safe Cities Authority (PSCA),
# Rescue 15 Lahore/Islamabad, and Sindh Police Madadgar 15.
# If configured, every SOS incident automatically posts the full telemetry packet
# (vehicle plate, driver name, live GPS, speed) to this secure endpoint.
RESCUE_15_POLICE_WEBHOOK_URL=""
