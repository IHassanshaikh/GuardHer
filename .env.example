```env.example
# This file contains environment variables required for the GuardHer application.
# DO NOT commit real secrets, passwords, or active API keys to version control.
# Instead, create a `.env` file in the root directory and populate it with your actual values.

# -----------------------------------------------------------------------------
# Server / Runtime settings
# -----------------------------------------------------------------------------

# NODE_ENV
# Specifies the environment the application is running in.
# Recommended values: 'development', 'production', 'test'.
NODE_ENV=development

# PORT
# The port on which the Next.js application will run.
# Default for Next.js is 3000.
PORT=3000

# NEXT_PUBLIC_APP_URL
# The base URL of your application. Used for absolute URLs and NextAuth.js callbacks.
# This variable is publicly exposed to the client-side.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database credentials
# -----------------------------------------------------------------------------

# MONGODB_URI
# Connection string for your MongoDB database.
# Example for a local MongoDB instance: mongodb://localhost:27017/guardher
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster-url>/guardher?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/guardher"

# -----------------------------------------------------------------------------
# API Keys & Secrets
# -----------------------------------------------------------------------------

# NEXTAUTH_SECRET
# A random string used to sign and encrypt NextAuth.js session tokens.
# It is CRITICAL for security. Generate a strong, long random string (e.g., using `openssl rand -base64 32`).
NEXTAUTH_SECRET="your_nextauth_secret_key_here_generate_a_strong_one"

# NEXTAUTH_URL
# The base URL of your application, used for NextAuth.js callbacks.
# Should match NEXT_PUBLIC_APP_URL in most cases.
NEXTAUTH_URL="http://localhost:3000"

# Google Maps API Keys
# Required for displaying maps and potentially for location-based services.
# Get your keys from Google Cloud Console.
# Ensure appropriate API services are enabled (e.g., Maps JavaScript API, Geocoding API).

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# Google Maps API key for client-side map rendering.
# This variable is publicly exposed to the client-side.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_client_api_key"

# GOOGLE_MAPS_SERVER_API_KEY
# Google Maps API key for server-side operations (e.g., geocoding, directions, distance matrix).
# Keep this key secure and do not expose it to the client-side.
GOOGLE_MAPS_SERVER_API_KEY="your_google_maps_server_api_key"

# Twilio Credentials
# Used for sending SMS messages (e.g., emergency alerts, notifications).
# Get your credentials from the Twilio Console.

# TWILIO_ACCOUNT_SID
# Your Twilio Account SID.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TWILIO_AUTH_TOKEN
# Your Twilio Auth Token.
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# TWILIO_PHONE_NUMBER
# The Twilio phone number (e.g., +15017122661) used to send messages.
TWILIO_PHONE_NUMBER="+1234567890"

# Pusher Credentials
# Used for real-time communication (e.g., live ride tracking, incident updates).
# Get your credentials from the Pusher Dashboard.

# PUSHER_APP_ID
# Your Pusher application ID.
PUSHER_APP_ID="1234567"

# NEXT_PUBLIC_PUSHER_KEY
# Your Pusher application key. This is publicly exposed to the client-side.
NEXT_PUBLIC_PUSHER_KEY="your_pusher_app_key"

# PUSHER_SECRET
# Your Pusher application secret. Keep this secure and do not expose it to the client-side.
PUSHER_SECRET="your_pusher_app_secret"

# PUSHER_CLUSTER
# The Pusher cluster your app is configured for (e.g., 'ap2', 'us2', 'eu').
PUSHER_CLUSTER="ap2"

# -----------------------------------------------------------------------------
# Cache & Messaging queues
# -----------------------------------------------------------------------------

# Note: Pusher variables above cover the real-time messaging queue aspect.
# No other explicit cache or messaging queue systems were identified from the provided files.
# If Redis or other caching solutions are introduced, their configuration would go here.
```